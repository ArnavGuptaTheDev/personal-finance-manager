{
  // Browser modules (parsers, categoriser, UI helpers) tested under Node: DOM types, no Worker types.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["./unit/**/*.ts", "./parsers/**/*.ts"]
}
