# Cloudflare Pages response headers for static pages.
# script-src/style-src are enforced by the hashed CSP <meta> tag Astro writes into
# every page; this header CSP only adds directives a <meta> tag cannot express.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/app/*
  Cache-Control: no-store
  X-Robots-Tag: noindex
  # Prefetch app pages on hover (Chromium). Prefetch only, never prerender: no page script
  # runs, so no API call is made before the person actually navigates.
  Speculation-Rules: "/speculation-rules.json"

/speculation-rules.json
  Content-Type: application/speculationrules+json

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
