---
// Layout for every signed-in page under /app/.
import Logo from '../components/Logo.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Base from './Base.astro';

interface Props {
  title: string;
  heading: string;
  subtitle?: string;
}
const { title, heading, subtitle } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');

// Icons are 24×24 stroke paths.
const ICON = {
  dashboard: 'M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 3v6h8V3z',
  transactions: 'M4 6h16M4 12h16M4 18h10',
  import: 'M12 3v12m0 0l-4-4m4 4l4-4M4 17v3h16v-3',
  budgets: 'M12 2a10 10 0 1 0 10 10H12z M14 2.2V10h7.8A10 10 0 0 0 14 2.2z',
  categories: 'M3 3h7l11 11-7 7L3 10zM7.5 7.5h.01',
  loans: 'M17 20v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 20v-2a4 4 0 0 0-3-3.9M16 2.1a4 4 0 0 1 0 7.8',
  emis: 'M3 5h18v14H3zM3 10h18M8 15h3',
  access: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4',
  audit: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h5',
  settings: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z',
  more: 'M5 12h.01M12 12h.01M19 12h.01',
  logout: 'M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9',
};

type Item = { href: string; label: string; icon: keyof typeof ICON; tab?: boolean; ownerOnly?: boolean };
// Edit this list to change the navigation. `tab` items are in the phone tab bar; the rest go under More.
// Owner-only items come last, so revealing them never moves another item.
const nav: Item[] = [
  { href: '/app/', label: 'Dashboard', icon: 'dashboard', tab: true },
  { href: '/app/transactions/', label: 'Transactions', icon: 'transactions', tab: true },
  { href: '/app/import/', label: 'Import', icon: 'import', tab: true },
  { href: '/app/budgets/', label: 'Budgets', icon: 'budgets', tab: true },
  { href: '/app/categories/', label: 'Categories', icon: 'categories' },
  { href: '/app/loans/', label: 'Loans', icon: 'loans' },
  { href: '/app/emis/', label: 'EMIs', icon: 'emis' },
  { href: '/app/settings/', label: 'Settings', icon: 'settings' },
  { href: '/app/admin/', label: 'Access', icon: 'access', ownerOnly: true },
  { href: '/app/admin/audit/', label: 'Audit log', icon: 'audit', ownerOnly: true },
];
const current = (href: string) => (path === href ? 'page' : undefined);
const inMore = !nav.some((i) => i.tab && i.href === path);
---

<Base title={`${title} · Personal Finance Manager`}>
  <div class="app">
    <div class="sidebar-col">
      <aside class="sidebar">
        <a class="brand" href="/app/"><Logo /><span>Personal Finance Manager</span></a>
        <nav class="nav" aria-label="Main">
          {
            nav.map((item) => (
              <>
                {item.ownerOnly && item.href === '/app/admin/' && <div class="nav-sep" data-owner-only hidden />}
                <a href={item.href} aria-current={current(item.href)} data-owner-only={item.ownerOnly ? '' : undefined} hidden={item.ownerOnly}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={ICON[item.icon]} />
                  </svg>
                  <span>{item.label}</span>
                </a>
              </>
            ))
          }
        </nav>
        <div class="user-box">
          <span class="avatar" data-avatar aria-hidden="true"></span>
          <div class="who">
            <span data-user-name></span>
            <span data-user-email class="muted small"></span>
          </div>
          <button class="btn btn-ghost btn-sm" type="button" data-logout>Sign out</button>
        </div>
      </aside>
    </div>

    <main class="main" id="main">
      <PageHeader heading={heading} subtitle={subtitle}><slot name="actions" /></PageHeader>
      <slot />
    </main>

    <nav class="tabbar" aria-label="Main">
      {
        nav
          .filter((i) => i.tab)
          .map((item) => (
            <a href={item.href} aria-current={current(item.href)}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={ICON[item.icon]} />
              </svg>
              <span>{item.label}</span>
            </a>
          ))
      }
      <button type="button" id="more-btn" aria-haspopup="dialog" aria-current={inMore ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
          <path d={ICON.more} />
        </svg>
        <span>More</span>
      </button>
    </nav>

    <dialog class="sheet" id="more-sheet" aria-label="More">
      <div class="row sheet-user">
        <span class="avatar" data-avatar aria-hidden="true"></span>
        <div class="who">
          <div data-user-name></div>
          <div data-user-email class="muted small"></div>
        </div>
      </div>
      <nav class="sheet-nav" aria-label="More pages">
        {
          nav
            .filter((i) => !i.tab)
            .map((item) => (
              <a href={item.href} aria-current={current(item.href)} data-owner-only={item.ownerOnly ? '' : undefined} hidden={item.ownerOnly}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={ICON[item.icon]} />
                </svg>
                {item.label}
              </a>
            ))
        }
        <button type="button" data-logout>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={ICON.logout} />
          </svg>
          Sign out
        </button>
      </nav>
      <button class="btn" type="button" data-close>Close</button>
    </dialog>
  </div>
</Base>

<script>
  import '../client/shell';
</script>
