---
import AppShell from '../../../layouts/AppShell.astro';
---

<AppShell title="Audit log" heading="Audit log" subtitle="Every action by every user. Entries cannot be edited or deleted.">
  <div class="stack">
    <p id="not-owner" class="card" hidden>Only owners can view the audit log.</p>

    <form id="audit-filters" class="card form-grid" role="search">
      <label>User<select name="user_id" id="audit-user"><option value="">Everyone</option></select></label>
      <label>Activity<select name="action" id="audit-action"><option value="">All activity</option></select></label>
      <label>Result
        <select name="outcome">
          <option value="">Any result</option>
          <option value="success">Success</option>
          <option value="failure">Failure</option>
          <option value="denied">Denied</option>
        </select>
      </label>
      <label>From<input name="from" type="date" /></label>
      <label>To<input name="to" type="date" /></label>
      <div class="row"><button class="btn" type="submit">Apply</button><button class="btn btn-ghost" type="reset">Clear</button></div>
    </form>

    <section class="card">
      <div class="table-wrap">
        <table>
          <thead id="audit-head"></thead>
          <tbody id="audit-rows"></tbody>
        </table>
      </div>
      <div class="row"><span class="spacer"></span><button class="btn btn-sm" id="more" type="button" hidden>Load older</button></div>
    </section>
  </div>
</AppShell>

<script>
  import '../../../client/pages/admin-audit';
</script>
