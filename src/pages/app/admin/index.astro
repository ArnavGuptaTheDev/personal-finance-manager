---
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import Field from '../../../components/ui/Field.astro';
import Table from '../../../components/ui/Table.astro';
import AppShell from '../../../layouts/AppShell.astro';
---

<AppShell title="Access" heading="Access" subtitle="Who can use this app. Owners are set in OWNER_EMAILS.">
  <div class="stack">
    <p id="not-owner" class="card" hidden>Only owners can manage access.</p>

    <form id="grant-form" class="card form">
      <div class="form-inline">
        <Field label="Google email to invite" name="email" type="email" required maxlength="254" autocomplete="off" placeholder="friend@gmail.com" />
        <Field label="Note (optional)" name="note" maxlength="200" placeholder="e.g. Sister" />
        <Button variant="primary" type="submit">Give access</Button>
      </div>
      <p class="muted small">
        Each person only ever sees their own data. As an owner you can see their activity in the audit log, never their
        transactions or balances.
      </p>
    </form>

    <Card>
      <Table
        bodyId="user-rows"
        skeleton={3}
        columns={[
          { label: 'Person' },
          { label: 'Role' },
          { label: 'Status' },
          { label: 'Last sign-in' },
          { label: 'Access from' },
          { label: 'Actions', hidden: true, class: 'shrink' },
        ]}
      />
    </Card>
  </div>
</AppShell>

<script>
  import '../../../client/pages/admin-access';
</script>
