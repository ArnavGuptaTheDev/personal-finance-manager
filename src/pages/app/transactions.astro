---
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Field from '../../components/ui/Field.astro';
import Select from '../../components/ui/Select.astro';
import Table from '../../components/ui/Table.astro';
import AppShell from '../../layouts/AppShell.astro';

const typeOptions = [
  { value: '', label: 'Debits & credits' },
  { value: 'debit', label: 'Debits only' },
  { value: 'credit', label: 'Credits only' },
];
---

<AppShell title="Transactions" heading="Transactions" subtitle="Search, recategorize and edit">
  <Fragment slot="actions">
    <Button variant="default" class="filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="filters">Filters</Button>
    <Button variant="primary" id="add-btn">+ Add transaction</Button>
  </Fragment>

  <div class="stack">
    <form id="filters" class="card filters" role="search">
      <Field label="Search" name="q" type="search" placeholder="Description or remark" maxlength="100" data-search />
      <Select label="Category" name="category" id="filter-category" options={[{ value: '', label: 'All categories' }]} />
      <Select label="Type" name="type" options={typeOptions} />
      <Field label="From" name="from" type="date" />
      <Field label="To" name="to" type="date" />
      <Button variant="ghost" type="reset">Clear</Button>
    </form>

    <Card>
      <div class="card-head list-head">
        <div id="summary-line" class="small muted"><span class="skeleton skeleton-text"></span></div>
        <span class="spacer"></span>
        <div class="row" id="bulk-box" hidden>
          <span id="bulk-count" class="small"></span>
          <label class="visually-hidden" for="bulk-category">Category for selected</label>
          <select id="bulk-category"></select>
          <Button size="sm" id="bulk-apply">Set category</Button>
          <Button size="sm" variant="ghost-danger" id="bulk-delete">Delete</Button>
        </div>
      </div>
      <div class="slot-table">
        <Table
          bodyId="rows"
          columns={[
            { label: 'Select all on this page', checkId: 'select-all', class: 'shrink' },
            { label: 'Date', class: 'shrink' },
            { label: 'Description' },
            { label: 'Category' },
            { label: 'Amount', class: 'right' },
            { label: 'Actions', hidden: true, class: 'shrink' },
          ]}
          skeleton={8}
        />
      </div>
      <div class="row pager">
        <Button size="sm" id="prev">← Newer</Button>
        <span class="muted small" id="page-info"></span>
        <Button size="sm" id="next">Older →</Button>
      </div>
    </Card>
  </div>

  <dialog id="txn-dialog" class="dialog-form" aria-labelledby="txn-dialog-title">
    <form id="txn-form" class="form">
      <h2 id="txn-dialog-title">Add transaction</h2>
      <div class="form-row keep-2">
        <Field label="Date" name="date" required autocomplete="off" data-date placeholder="today, 3/10, 3 Oct" hint="Day first: today, 3/10, 3 Oct" />
        <Field label="Amount (₹)" name="amount" money required placeholder="0.00" />
      </div>
      <div class="form-row">
        <Select
          label="Type"
          name="type"
          options={[
            { value: 'debit', label: 'Debit (money out)' },
            { value: 'credit', label: 'Credit (money in)' },
          ]}
        />
        <label class="field" id="txn-category-field">
          <span>Category</span>
          <div class="typeahead"><input data-typeahead placeholder="Type to search" /></div>
          <input type="hidden" name="category_id" />
          <span class="field-error"></span>
        </label>
      </div>
      <Field label="Description" name="description" required maxlength="500" />
      <Field label="Remark" name="remark" maxlength="500" placeholder="Optional note" />
      <div class="form-actions">
        <Button data-close>Cancel</Button>
        <!-- Save comes first in the DOM so Enter (implicit submission) means Save; CSS puts it last. -->
        <Button variant="primary" type="submit" class="order-last">Save</Button>
        <Button type="submit" id="txn-another" title="Ctrl + Enter">Save and add another</Button>
      </div>
    </form>
  </dialog>
</AppShell>

<script>
  import '../../client/pages/transactions';
</script>

<style>
  .list-head { min-height: 40px; }
  .pager { justify-content: center; margin-top: var(--space-3); }
</style>
