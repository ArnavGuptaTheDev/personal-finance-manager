---
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import AppShell from '../../layouts/AppShell.astro';
---

<AppShell title="Settings" heading="Settings" subtitle="Your account and data">
  <div class="stack">
    <Card title="Account">
      <p class="muted">Signed in with Google as <strong data-user-email></strong> <span id="settings-role" class="badge"></span></p>
    </Card>

    <Card title="Export your data">
      <p class="muted">Download every transaction, category, budget, loan and EMI as a JSON file.</p>
      <Button href="/api/me/export" download>Download export</Button>
    </Card>

    <Card title="Delete account" class="card-danger">
      <p class="muted">Permanently deletes your account and all of your data, straight away. This cannot be undone.</p>
      <Button variant="danger" id="delete-account">Delete my account</Button>
    </Card>

    <details class="card collapse" id="activity">
      <summary><h2>My activity</h2></summary>
      <p class="muted small">Every action on your account is recorded. App owners can see this activity log, but not your financial data.</p>
      <div class="table-wrap">
        <table class="table-cards">
          <thead id="activity-head"></thead>
          <tbody id="activity-rows"></tbody>
        </table>
      </div>
      <div class="form-actions"><Button size="sm" id="activity-more" hidden>Load older</Button></div>
    </details>
  </div>
</AppShell>

<script>
  import '../../client/pages/settings';
</script>
