---
import AppShell from '../../layouts/AppShell.astro';
---

<AppShell title="Budgets" heading="Budgets" subtitle="Monthly spending limits per category">
  <label slot="actions"><span class="visually-hidden">Month</span><input type="month" id="month" /></label>

  <div class="stack">
    <form id="budget-form" class="card form-grid">
      <label>Category<select name="category_id" id="budget-category" required></select></label>
      <label>Monthly limit (₹)<input name="amount" type="number" min="1" step="0.01" required inputmode="decimal" /></label>
      <div><button class="btn btn-primary" type="submit" id="budget-save">Save budget</button></div>
    </form>

    <section class="card">
      <h2 id="budget-title">This month</h2>
      <div id="budget-list"></div>
    </section>
  </div>
</AppShell>

<script>
  import '../../client/pages/budgets';
</script>
