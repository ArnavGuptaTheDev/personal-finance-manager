---
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Field from '../../components/ui/Field.astro';
import Select from '../../components/ui/Select.astro';
import Table from '../../components/ui/Table.astro';
import AppShell from '../../layouts/AppShell.astro';
---

<AppShell title="Import" heading="Import a statement" subtitle="Parsed on your device; the file itself is never uploaded">
  <div class="stack">
    <form id="parse-form" class="card form">
      <div class="form-row keep-2">
        <Select
          label="Bank"
          name="bank"
          id="bank-select"
          options={[
            { value: 'hdfc', label: 'HDFC Bank' },
            { value: 'icici', label: 'ICICI Bank' },
          ]}
        >
          <option value="other">Another bank (map the columns)</option>
        </Select>
        <Select
          label="Account"
          name="account"
          options={[
            { value: 'savings', label: 'Savings account' },
            { value: 'credit_card', label: 'Credit card' },
          ]}
        />
      </div>
      <label class="dropzone" id="dropzone">
        <input name="file" type="file" accept=".csv,.xls,.xlsx" id="file-input" />
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 15V3m0 0l-4 4m4-4l4 4M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"></path>
        </svg>
        <span class="file-name" id="file-name">Drop your statement here, or choose a file</span>
        <span class="muted small">Excel (.xls, .xlsx) or CSV, downloaded from net banking</span>
      </label>
      <p class="muted small hint">Re-importing an overlapping period is safe: transactions already stored are recognised and skipped.</p>
      <div class="form-actions">
        <Button variant="primary" type="submit" id="parse-btn">Read statement</Button>
      </div>
      <details class="collapse" id="formats-box" hidden>
        <summary><span class="small">Your saved formats</span></summary>
        <ul id="formats-list" class="plain-list small"></ul>
      </details>
    </form>

    <Card id="mapping" title="Map the columns" hidden>
      <p class="small spend" id="mapping-reason"></p>
      <p class="muted small">
        Pick the row that holds the column titles, then say what each column contains. The file still never leaves your
        device, and a saved format keeps only the column titles and these choices.
      </p>
      <form id="mapping-form" class="form">
        <div class="form-row cols-3">
          <Select label="Row with the column titles" name="header" id="map-header" />
          <Select
            label="Amounts"
            name="amounts"
            options={[
              { value: 'split', label: 'Separate money-out and money-in columns' },
              { value: 'negative-debit', label: 'One column, negative = money out' },
              { value: 'negative-credit', label: 'One column, negative = money in' },
              { value: 'marker', label: 'One column plus a Cr/Dr column' },
            ]}
          />
          <Select
            label="Dates"
            name="dateOrder"
            options={[
              { value: 'dmy', label: 'Day first (05/04 = 5 April)' },
              { value: 'mdy', label: 'Month first (04/05 = 5 April)' },
              { value: 'ymd', label: 'Year first (2026-04-05)' },
            ]}
          />
        </div>
        <div class="form-row cols-4" id="map-columns">
          <Select label="Date" name="date" data-role="date" />
          <Select label="Description" name="description" data-role="description" />
          <Select label="Money out" name="debit" data-role="debit" fieldClass="for-split" />
          <Select label="Money in" name="credit" data-role="credit" fieldClass="for-split" />
          <Select label="Amount" name="amount" data-role="amount" fieldClass="for-single" />
          <Select label="Cr/Dr column" name="sign" data-role="sign" fieldClass="for-marker" />
          <Select label="Balance (optional)" name="balance" data-role="balance" hint="Used to check every row" />
        </div>
        <div class="table-wrap"><table id="map-sample" class="map-sample"></table></div>
        <div class="form-inline">
          <Field label="Save as a format (optional)" name="save_name" maxlength="60" placeholder="e.g. SBI savings" />
          <Button variant="primary" type="submit">Preview transactions</Button>
        </div>
      </form>
    </Card>

    <Card id="preview" hidden>
      <div class="card-head">
        <h2>Review</h2>
        <span class="spacer"></span>
        <span class="muted small" id="preview-meta"></span>
        <label class="row small last4">
          <span>Account ending</span>
          <input id="last4" inputmode="numeric" maxlength="4" placeholder="····" aria-describedby="last4-source" />
        </label>
        <span class="muted small" id="last4-source"></span>
      </div>
      <div id="parse-summary" class="small"></div>
      <div id="corrections" class="card corrections" hidden>
        <h3>Already imported with different details</h3>
        <p class="muted small">
          These transactions are already stored, but with values an earlier version of the importer got wrong (for example
          a day/month-swapped date or a missing part of the description). Correct the stored copies instead of importing
          them again.
        </p>
        <ul id="correction-list" class="plain-list small"></ul>
        <div class="form-actions"><Button id="apply-corrections">Correct selected</Button></div>
      </div>
      <Table
        bodyId="preview-rows"
        skeleton={0}
        columns={[
          { label: 'Select all', checkId: 'all', class: 'shrink' },
          { label: 'Date', class: 'shrink' },
          { label: 'Description' },
          { label: 'Category' },
          { label: 'Amount', class: 'right' },
        ]}
      />
      <div class="form-actions preview-actions">
        <Button id="discard">Discard</Button>
        <Button variant="primary" id="save">Import</Button>
      </div>
    </Card>
  </div>
</AppShell>

<script>
  import '../../client/pages/import';
</script>

<style>
  .hint { margin: 0; }
  .corrections { margin: var(--space-3) 0; box-shadow: none; background: var(--bg); }
  .preview-actions { margin-top: var(--space-4); }
  .last4 input { width: 5.5rem; min-height: 32px; }
  #mapping-form[data-amounts='split'] :global(.for-single),
  #mapping-form[data-amounts='split'] :global(.for-marker),
  #mapping-form:not([data-amounts='split']) :global(.for-split),
  #mapping-form:not([data-amounts='marker']) :global(.for-marker) { display: none; }
  .map-sample { font-size: var(--text-xs); }
  .map-sample :global(td), .map-sample :global(th) { height: auto; white-space: nowrap; max-width: 220px; overflow: hidden; text-overflow: ellipsis; }
</style>
