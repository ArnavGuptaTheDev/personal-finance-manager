---
import Button from '../../components/ui/Button.astro';
import Field from '../../components/ui/Field.astro';
import Select from '../../components/ui/Select.astro';
import Card from '../../components/ui/Card.astro';
import Skeleton from '../../components/ui/Skeleton.astro';
import Tabs from '../../components/ui/Tabs.astro';
import AppShell from '../../layouts/AppShell.astro';

const kinds = [
  { value: 'expense', label: 'Expense' },
  { value: 'income', label: 'Income' },
  { value: 'transfer', label: 'Transfer (excluded from totals)' },
];
---

<AppShell title="Categories" heading="Categories" subtitle="Rules that sort imported transactions automatically">
  <Tabs
    id="cat-tabs"
    label="Categories page sections"
    tabs={[
      { value: 'categories', label: 'Categories' },
      { value: 'rules', label: 'Rule health' },
    ]}
  />

  <div class="stack" id="panel-categories">
    <form id="cat-form" class="card form-inline">
      <Field label="New category" name="name" required maxlength="60" placeholder="e.g. Pets" />
      <Select label="Kind" name="kind" options={kinds} />
      <Button variant="primary" type="submit">Add category</Button>
    </form>

    <div class="row cat-tools">
      <Field label="Search categories and rules" hideLabel type="search" id="cat-search" data-search placeholder="Search categories and rules" fieldClass="cat-search" />
      <Button variant="ghost" size="sm" id="toggle-all">Expand all</Button>
    </div>
    <p class="muted small">
      Keywords match whole words in the transaction description (case-insensitive). Regex rules (written as /pattern/) are
      for advanced patterns and are checked first. Your own rules always win over the built-in ones.
    </p>

    <div id="cat-list" class="grid grid-2 cat-list"><Skeleton variant="row" count={6} /></div>
  </div>

  <div class="stack" id="panel-rules" hidden>
    <Card title="Test a rule">
      <p class="muted small">Type a keyword or a /regex/ to see which of your transactions it would match. Nothing is saved.</p>
      <label class="field">
        <span class="visually-hidden">Rule to test</span>
        <input id="rule-test" placeholder="e.g. swiggy, or /^upi.*zomato/" autocomplete="off" />
        <span class="field-error" id="rule-test-error"></span>
      </label>
      <p class="small" id="rule-test-result" aria-live="polite"></p>
      <ul class="plain-list small" id="rule-test-samples"></ul>
    </Card>
    <Card title="Rule health">
      <p class="muted small" id="rules-summary"><span class="skeleton skeleton-text"></span></p>
      <div id="rules-conflicts"></div>
      <div id="rules-dead"></div>
      <div class="table-wrap">
        <table class="table-cards">
          <thead><tr><th>Rule</th><th>Category</th><th class="right">Matches</th></tr></thead>
          <tbody id="rules-rows"></tbody>
        </table>
      </div>
    </Card>
  </div>

  <dialog id="cat-dialog" class="dialog-form" aria-labelledby="cat-dialog-title">
    <form id="cat-edit" class="form">
      <h2 id="cat-dialog-title">Edit category</h2>
      <Field label="Name" name="name" required maxlength="60" />
      <Select label="Kind" name="kind" options={kinds} />
      <div class="form-actions">
        <Button data-close>Cancel</Button>
        <Button variant="primary" type="submit">Save</Button>
      </div>
    </form>
  </dialog>
</AppShell>

<script>
  import '../../client/pages/categories';
</script>

<style>
  .cat-tools { flex-wrap: nowrap; }
  .cat-search { flex: 1; max-width: 420px; }
  .cat-list { align-items: start; }
</style>
