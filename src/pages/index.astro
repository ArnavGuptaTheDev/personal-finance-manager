---
import Logo from '../components/Logo.astro';
import Base from '../layouts/Base.astro';

// Landing page copy — edit freely.
const features = [
  {
    title: 'Import bank statements',
    body: 'Drop in HDFC or ICICI statements (savings or credit card). Files are parsed in your browser and never uploaded.',
  },
  {
    title: 'Automatic categories',
    body: 'Keyword and pattern rules sort transactions for you. Add your own rules for the merchants you use.',
  },
  {
    title: 'Budgets that keep score',
    body: 'Set a monthly limit per category and see at a glance where you are over.',
  },
  {
    title: 'Loans and EMIs',
    body: 'Track money lent to or borrowed from friends, and see every EMI’s next due date and remaining balance.',
  },
];
---

<Base title="Personal Finance Manager">
  <div class="landing">
    <header class="top">
      <a class="brand" href="/"><Logo /><span>Personal Finance Manager</span></a>
      <a class="btn" href="/login/">Sign in</a>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Personal finance, without the spreadsheet</p>
        <h1>Know where every rupee went.</h1>
        <p class="lede">
          Import your bank statements, let Personal Finance Manager sort the spending, and keep budgets, loans and EMIs in one calm place.
        </p>
        <div class="row">
          <a class="btn btn-primary btn-lg" href="/login/">Get started with Google</a>
        </div>
        <p class="muted small">Free. Your data stays in your account and can be exported or deleted any time.</p>
      </div>

      <svg class="hero-art" viewBox="0 0 420 320" role="img" aria-label="Illustration of a spending chart">
        <rect x="10" y="20" width="400" height="280" rx="22" class="art-card"></rect>
        <g class="art-bars">
          <rect x="50" y="170" width="26" height="90" rx="5"></rect>
          <rect x="100" y="130" width="26" height="130" rx="5"></rect>
          <rect x="150" y="190" width="26" height="70" rx="5"></rect>
          <rect x="200" y="110" width="26" height="150" rx="5"></rect>
          <rect x="250" y="150" width="26" height="110" rx="5"></rect>
          <rect x="300" y="90" width="26" height="170" rx="5"></rect>
          <rect x="350" y="120" width="26" height="140" rx="5"></rect>
        </g>
        <path class="art-line" d="M63 150 L113 112 L163 168 L213 92 L263 128 L313 70 L363 100"></path>
        <g class="art-dots">
          <circle cx="63" cy="150" r="5"></circle><circle cx="113" cy="112" r="5"></circle><circle cx="163" cy="168" r="5"></circle>
          <circle cx="213" cy="92" r="5"></circle><circle cx="263" cy="128" r="5"></circle><circle cx="313" cy="70" r="5"></circle>
          <circle cx="363" cy="100" r="5"></circle>
        </g>
        <text x="40" y="58" class="art-label">Spent this month</text>
        <text x="40" y="86" class="art-value">₹42,310</text>
      </svg>
    </section>

    <section class="features" aria-label="Features">
      {
        features.map((f) => (
          <article class="card">
            <h2>{f.title}</h2>
            <p class="muted">{f.body}</p>
          </article>
        ))
      }
    </section>

    <section class="trust card">
      <h2>Built to keep your data private</h2>
      <ul>
        <li>Sign in with Google: no passwords are stored here.</li>
        <li>Statements are read on your device. Only the transactions you confirm are saved.</li>
        <li>Every record is tied to your account and checked on every request.</li>
        <li>Export everything as JSON, or delete your account and all data in one click.</li>
      </ul>
    </section>

    <footer class="foot muted small row">
      <span>© Personal Finance Manager</span>
      <span class="spacer"></span>
      <a href="/privacy/">Privacy Policy</a>
    </footer>
  </div>
</Base>

<style>
  .landing { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .top { display: flex; align-items: center; justify-content: space-between; padding: 1.2rem 0; }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding: clamp(2rem, 6vw, 5rem) 0;
  }
  .eyebrow { color: var(--warning); font-weight: 650; letter-spacing: 0.02em; margin-bottom: 0.8rem; }
  .hero h1 { font-size: clamp(2.4rem, 1.6rem + 3.6vw, 4.4rem); font-weight: 800; letter-spacing: -0.035em; }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 34ch; margin: 1rem 0 1.6rem; }
  .btn-lg { padding: 0.8rem 1.4rem; font-size: 1rem; }
  .hero-copy .small { margin-top: 1rem; }

  .hero-art { width: 100%; height: auto; }
  .art-card { fill: var(--surface); stroke: var(--line); }
  .art-bars rect { fill: var(--surface-2); transform-origin: bottom; transform-box: fill-box; animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .art-bars rect:nth-child(2) { animation-delay: 0.05s; }
  .art-bars rect:nth-child(3) { animation-delay: 0.1s; }
  .art-bars rect:nth-child(4) { animation-delay: 0.15s; }
  .art-bars rect:nth-child(5) { animation-delay: 0.2s; }
  .art-bars rect:nth-child(6) { animation-delay: 0.25s; fill: var(--warning); }
  .art-bars rect:nth-child(7) { animation-delay: 0.3s; }
  .art-line { fill: none; stroke: var(--brand); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 600; animation: draw 1.6s 0.3s ease forwards; stroke-dashoffset: 600; }
  .art-dots circle { fill: var(--surface); stroke: var(--brand); stroke-width: 3; }
  .art-label { fill: var(--muted); font: 500 14px var(--font-text); }
  .art-value { fill: var(--ink); font: 700 26px var(--font-display); }
  @keyframes rise { from { transform: scaleY(0); } }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .features p { margin: 0; }
  .trust { margin: 2.5rem 0; }
  .trust ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .foot { padding: 2rem 0 3rem; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .hero-art { max-width: 460px; }
  }
</style>
