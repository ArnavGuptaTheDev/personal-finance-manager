{
  "name": "personal-finance-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro build && wrangler pages dev",
    "dev:ui": "astro dev",
    "build": "astro check && astro build",
    "typecheck": "astro check && tsc -p server/tsconfig.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply finance-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply finance-db --remote",
    "deploy": "astro build && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.5",
    "hono": "^4.13.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261002.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
}
